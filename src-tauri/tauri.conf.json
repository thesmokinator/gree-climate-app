{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gree Climate",
  "version": "0.1.0",
  "identifier": "com.thesmokinator.gree-climate",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gree Climate",
        "width": 470,
        "height": 640,
        "resizable": false,
        "minWidth": 470,
        "maxWidth": 470,
        "minHeight": 240,
        "maxHeight": 1400
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
